# manual_reviewer_cvat — stack env vars
#
# Copy to stack.env and edit. docker-compose.cvat.yml and manage_cvat.sh both
# source this file. Keep OUT of git (already in .gitignore via *.env pattern).

# ─── Ports (host-side) ───
# CVAT UI / API. Pick a port not used by LS (which sits on 8080).
CVAT_HOST_PORT=8081
# Internal services — only need overriding on multi-CVAT hosts.
CVAT_POSTGRES_HOST_PORT=5433
CVAT_REDIS_HOST_PORT=6380
CVAT_CLICKHOUSE_HOST_PORT=8124

# ─── Hostname seen by browsers ───
# If reviewers hit CVAT from another machine, set this to the host's
# routable name/IP. localhost works for same-host testing only.
CVAT_HOST=127.0.0.1

# ─── Persistent state ───
# Postgres data + uploaded media + cache. Pick a host path with enough
# disk for all clips × users × historical exports.
CVAT_DATA_DIR=/tmp/datatang_review/.cvat_data
CVAT_BACKUP_DIR=/media/data_2/vlm/code/data_miner/manual_reviewer_cvat/.cvat_backup
BACKUP_KEEP_SNAPSHOTS=288   # 24h × 12/hour at 5-min cadence

# ─── Shared-folder mount (image-mount-mode=shared-folder) ───
# When set, CVAT can ingest images by path (no upload). The path on the
# HOST is mounted read-only into the cvat_server container at /home/django/share.
# Use this so the 1000-clip image set isn't duplicated into Postgres BLOBs.
CVAT_SHARE_PATH=/media/data_2/vlm/code/data_miner/output

# ─── Admin bootstrap (used by manage_cvat.sh create-superuser) ───
CVAT_ADMIN_USER=admin
CVAT_ADMIN_EMAIL=admin@example.com
# Leave blank to be prompted interactively.
CVAT_ADMIN_PASSWORD=

# ─── pipeline.db round-trip (used by export_to_aa_v4.py) ───
AAV4_PIPELINE_DB=/tmp/datatang_review/pipeline.db

# ─── Compose project name (so `docker compose` doesn't pick up upstream cvat) ───
COMPOSE_PROJECT_NAME=cvat_review
