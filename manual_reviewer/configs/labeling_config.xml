  </View>

  <View visibleWhen="choice-selected" whenTagName="auto_tool" whenChoiceValue="smart_track">
  <RectangleLabels name="smart_track" toName="image"
                   smart="true"
                   strokeColor="#16a085" opacity="0.05" strokeWidth="2">
    <Label value="person" background="#e74c3c" hotkey="1"/>
    <Label value="bicycle" background="#3498db" hotkey="2"/>
    <Label value="car" background="#2ecc71" hotkey="3"/>
    <Label value="motorcycle" background="#9b59b6" hotkey="4"/>
    <Label value="airplane" background="#e67e22" hotkey="5"/>
    <Label value="bus" background="#f1c40f" hotkey="6"/>
    <Label value="train" background="#1abc9c" hotkey="7"/>
