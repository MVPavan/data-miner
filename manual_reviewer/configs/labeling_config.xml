<!--
  Label Studio labeling interface for the aa_v4 manual review system.

  GENERATED FROM /tmp/datatang_review/classes.txt. Do not hand-edit; rerun
  ``python -m manual_reviewer.configs.build_labeling_config`` after
  the dataset's classes.txt changes.

  Phase A: <RectangleLabels name="bbox"> drives the rectangle tool and
  carries the class palette. <KeyPointLabels name="click"> mirrors the
  same palette for the smart_click tool so the reviewer's hotkey class
  rides every keypoint draft as value.keypointlabels.

  KeyPoint, TextArea and the V-tool Rectangle are gated by `smart="true"`
  so the ML backend handles those interactions.
-->
<View>
  <Header value="aa_v4 Manual Review"/>

  <View style="display:flex; gap:8px; align-items:center; margin-bottom:6px;">
    <Header value="Auto:"/>
    <Choices name="auto_tool" toName="image" choice="single" showInline="true">
      <Choice value="none"          hotkey="escape" selected="true"/>
      <Choice value="visual_prompt" hotkey="ctrl+v"/>
      <Choice value="smart_click"   hotkey="ctrl+k"/>
      <Choice value="smart_text"    hotkey="ctrl+t"/>
      <Choice value="smart_track"   hotkey="ctrl+g"/>
    </Choices>
  </View>

  <Image name="image" value="$image" zoom="true" zoomControl="true"
         rotateControl="false" brightnessControl="false"
         maxHeight="78vh"/>

  <View visibleWhen="choice-selected" whenTagName="auto_tool" whenChoiceValue="none">
  <RectangleLabels name="bbox" toName="image" opacity="0.05" strokeWidth="2">
    <Label value="person" background="#e74c3c" hotkey="1"/>
    <Label value="bicycle" background="#3498db" hotkey="2"/>
    <Label value="car" background="#2ecc71" hotkey="3"/>
    <Label value="motorcycle" background="#9b59b6" hotkey="4"/>
    <Label value="airplane" background="#e67e22" hotkey="5"/>
    <Label value="bus" background="#f1c40f" hotkey="6"/>
    <Label value="train" background="#1abc9c" hotkey="7"/>
    <Label value="truck" background="#34495e" hotkey="8"/>
    <Label value="boat" background="#7f8c8d" hotkey="9"/>
    <Label value="bird" background="#c0392b" hotkey="0"/>
    <Label value="cat" background="#2980b9" hotkey="q"/>
    <Label value="dog" background="#27ae60" hotkey="w"/>
    <Label value="backpack" background="#8e44ad" hotkey="e"/>
    <Label value="handbag" background="#d35400" hotkey="r"/>
    <Label value="suitcase" background="#f39c12" hotkey="t"/>
    <Label value="shopping cart" background="#16a085" hotkey="y"/>
    <Label value="helicopter" background="#2c3e50" hotkey="u"/>
    <Label value="wallet" background="#95a5a6" hotkey="i"/>
    <Label value="forklift" background="#e84393" hotkey="o"/>
    <Label value="palletjack" background="#fd79a8" hotkey="p"/>
    <Label value="head" background="#a29bfe" hotkey="a"/>
    <Label value="laptop" background="#fdcb6e" hotkey="s"/>
    <Label value="cellphone" background="#74b9ff" hotkey="d"/>
  </RectangleLabels>
  </View>

  <View visibleWhen="choice-selected" whenTagName="auto_tool" whenChoiceValue="smart_click">
  <KeyPointLabels name="click" toName="image" smart="true" strokeWidth="3">
    <Label value="person" background="#e74c3c" hotkey="1"/>
    <Label value="bicycle" background="#3498db" hotkey="2"/>
    <Label value="car" background="#2ecc71" hotkey="3"/>
    <Label value="motorcycle" background="#9b59b6" hotkey="4"/>
    <Label value="airplane" background="#e67e22" hotkey="5"/>
    <Label value="bus" background="#f1c40f" hotkey="6"/>
    <Label value="train" background="#1abc9c" hotkey="7"/>
    <Label value="truck" background="#34495e" hotkey="8"/>
    <Label value="boat" background="#7f8c8d" hotkey="9"/>
    <Label value="bird" background="#c0392b" hotkey="0"/>
    <Label value="cat" background="#2980b9" hotkey="q"/>
    <Label value="dog" background="#27ae60" hotkey="w"/>
    <Label value="backpack" background="#8e44ad" hotkey="e"/>
    <Label value="handbag" background="#d35400" hotkey="r"/>
    <Label value="suitcase" background="#f39c12" hotkey="t"/>
    <Label value="shopping cart" background="#16a085" hotkey="y"/>
    <Label value="helicopter" background="#2c3e50" hotkey="u"/>
    <Label value="wallet" background="#95a5a6" hotkey="i"/>
    <Label value="forklift" background="#e84393" hotkey="o"/>
    <Label value="palletjack" background="#fd79a8" hotkey="p"/>
