    <Label value="cellphone" background="#74b9ff" hotkey="d"/>
  </KeyPointLabels>
  </View>

  <View visibleWhen="choice-selected" whenTagName="auto_tool" whenChoiceValue="visual_prompt">
  <RectangleLabels name="visual_prompt" toName="image"
                   smart="true"
                   strokeColor="#ff7700" opacity="0.05" strokeWidth="2">
    <Label value="person" background="#e74c3c" hotkey="1"/>
    <Label value="bicycle" background="#3498db" hotkey="2"/>
    <Label value="car" background="#2ecc71" hotkey="3"/>
